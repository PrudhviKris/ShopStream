# Copy to .env and fill in real values

# Database — MySQL 8.0+ (Windows service MySQL80/MySQL90 on port 3306).
# The database is created automatically on first run if it doesn't exist.
# Without MYSQL_PASSWORD the app falls back to local SQLite.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-root-password
MYSQL_DB=ecommerce
# Or override everything with a full URL:
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/ecommerce?charset=utf8mb4

# JWT
JWT_SECRET_KEY=generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth0 (social login: enable Google & Facebook connections in the Auth0 dashboard)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id

# Stripe (leave empty to run in mock mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=usd
CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel

# Cart
TAX_RATE=0.08

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
