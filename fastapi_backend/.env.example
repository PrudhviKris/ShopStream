# Copy to .env and fill in real values

# Database — MySQL 8.0+ (Windows service MySQL80/MySQL90 on port 3306).
# The database is created automatically on first run if it doesn't exist.
# Without MYSQL_PASSWORD the app falls back to local SQLite.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-root-password
MYSQL_DB=ecommerce
# Or override everything with a full URL:
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/ecommerce?charset=utf8mb4

# JWT — signs every access & refresh token (local AND social logins).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Social login (global users) ---
# Public origin users reach the app through (your ngrok URL when tunneling).
# OAuth redirect URIs are built from it and must be registered in each console:
#   Google:   {PUBLIC_URL}/api/auth/google/callback
#   Facebook: {PUBLIC_URL}/api/auth/facebook/callback
PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application),
#   add http://localhost:3000 to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Facebook: https://developers.facebook.com/apps -> add "Facebook Login" -> Settings > Basic
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Stripe (leave empty to run in mock mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Leave blank to use {PUBLIC_URL}/receipt (the storefront's receipt page).
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=

# Email notifications
# EMAIL_BACKEND=database stores emails (see the storefront's Emails page / GET /dev/emails);
# EMAIL_BACKEND=smtp sends them. SendGrid: smtp.sendgrid.net:587, user "apikey", password
# = API key. AWS SES: email-smtp.<region>.amazonaws.com:587 with SES SMTP credentials.
EMAIL_ENABLED=true
EMAIL_BACKEND=database
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
# Local (email/password) accounts never verify their address, so SMTP skips them by
# default; they read their mail in the in-app Inbox. Set true to email them too.
SMTP_SEND_TO_LOCAL_ACCOUNTS=false
EMAIL_FROM=no-reply@ecommerce.local

# Lets the Django admin move orders through this API (so shipping from
# /admin/ also emails the customer and updates their screen live). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable; the admin then falls back to a local status write.
SERVICE_API_TOKEN=

# Runtime / production hardening
# APP_ENV=production makes the app refuse to start with development secrets,
# wildcard CORS, SQLite, or auto-created tables (use Alembic there instead).
APP_ENV=development
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=true
# Auth endpoints: attempts per IP per window (login/register/refresh)
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60
# Behind HTTPS/a proxy: trust X-Forwarded-For and send HSTS
TRUST_PROXY_HEADERS=false
HSTS_SECONDS=0
# Hostnames the API answers to (comma-separated); empty = any
TRUSTED_HOSTS=

# Cart
TAX_RATE=0.08

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000
