{
  "info": {
    "name": "Smart E-Commerce Platform",
    "description": "Auth (JWT + Auth0 social), Products, Cart, Checkout (Stripe), Orders, Payments, Notifications.\n\nRun 'Auth > Login' first — a test script stores access_token & refresh_token into collection variables automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 201) {",
            "  const d = pm.response.json();",
            "  pm.collectionVariables.set('access_token', d.access_token);",
            "  pm.collectionVariables.set('refresh_token', d.refresh_token);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Demo Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"CustomerPass123!\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const d = pm.response.json();",
            "  pm.collectionVariables.set('access_token', d.access_token);",
            "  pm.collectionVariables.set('refresh_token', d.refresh_token);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"CustomerPass123!\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": [
            "if (pm.response.code === 200) {",
            "  const d = pm.response.json();",
            "  pm.collectionVariables.set('access_token', d.access_token);",
            "  pm.collectionVariables.set('refresh_token', d.refresh_token);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/refresh",
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" }
          }
        },
        {
          "name": "Me (current user)",
          "request": { "method": "GET", "url": "{{base_url}}/auth/me" }
        },
        {
          "name": "Social Login (Auth0)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/social/auth0",
            "body": { "mode": "raw", "raw": "{\n  \"id_token\": \"<auth0-id-token-from-frontend>\"\n}" },
            "description": "Paste the RS256 ID token returned by Auth0 Universal Login (Google/Facebook connection). Requires AUTH0_DOMAIN + AUTH0_CLIENT_ID in the backend .env."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products (filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?category=electronics&min_price=10&max_price=250&in_stock=true&sort=popularity&page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "category", "value": "electronics" },
                { "key": "min_price", "value": "10" },
                { "key": "max_price", "value": "250" },
                { "key": "in_stock", "value": "true" },
                { "key": "sort", "value": "popularity", "description": "popularity | price_asc | price_desc | newest" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          }
        },
        { "name": "Get Product by ID", "request": { "method": "GET", "url": "{{base_url}}/products/1" } },
        { "name": "Products by Category", "request": { "method": "GET", "url": "{{base_url}}/products/category/electronics" } },
        {
          "name": "Create Product (admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Smart Watch\",\n  \"description\": \"Fitness tracking smart watch\",\n  \"category\": \"electronics\",\n  \"price\": 129.99,\n  \"stock\": 40,\n  \"images\": [\"https://example.com/watch.jpg\"]\n}" }
          }
        },
        {
          "name": "Update Product (admin only)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/products/1",
            "body": { "mode": "raw", "raw": "{\n  \"price\": 19.99,\n  \"stock\": 200\n}" }
          }
        },
        { "name": "Delete Product (admin only)", "request": { "method": "DELETE", "url": "{{base_url}}/products/1" } }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/cart/add",
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}" }
          }
        },
        {
          "name": "Update Quantity",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/cart/update",
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 3\n}" }
          }
        },
        { "name": "Remove from Cart", "request": { "method": "DELETE", "url": "{{base_url}}/cart/remove/1" } },
        { "name": "View Cart (totals + tax)", "request": { "method": "GET", "url": "{{base_url}}/cart" } }
      ]
    },
    {
      "name": "Checkout & Payments",
      "item": [
        {
          "name": "Checkout (Stripe session)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/checkout?flow=session",
              "host": ["{{base_url}}"],
              "path": ["checkout"],
              "query": [{ "key": "flow", "value": "session", "description": "session (hosted checkout URL) | intent (client_secret for Stripe Elements)" }]
            }
          }
        },
        { "name": "Payment for Order", "request": { "method": "GET", "url": "{{base_url}}/payments/1" } },
        {
          "name": "Mock Confirm Payment (dev only)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/mock/confirm/1?outcome=success",
            "description": "Simulates the Stripe webhook when no STRIPE_SECRET_KEY is configured. Use outcome=failed to test failure."
          }
        },
        {
          "name": "Stripe Webhook (Stripe calls this)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Stripe-Signature", "value": "t=...,v1=..." }],
            "url": "{{base_url}}/payments/webhook",
            "description": "Configured in the Stripe dashboard; requires STRIPE_WEBHOOK_SECRET. Test locally with: stripe listen --forward-to localhost:8000/payments/webhook"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        { "name": "My Orders", "request": { "method": "GET", "url": "{{base_url}}/orders" } },
        { "name": "Order by ID", "request": { "method": "GET", "url": "{{base_url}}/orders/1" } },
        { "name": "All Orders (staff/admin)", "request": { "method": "GET", "url": "{{base_url}}/orders/all" } },
        {
          "name": "Update Order Status (staff/admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/orders/1/status",
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"shipped\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        { "name": "List Notifications", "request": { "method": "GET", "url": "{{base_url}}/notifications?unread_only=false" } },
        { "name": "Mark Read", "request": { "method": "PUT", "url": "{{base_url}}/notifications/1/read" } },
        { "name": "Mark All Read", "request": { "method": "PUT", "url": "{{base_url}}/notifications/read-all" } },
        {
          "name": "WebSocket (info)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/",
            "description": "Real-time stream is a WebSocket, not HTTP:\nws://localhost:8000/ws/notifications?token={{access_token}}\n\nIn Postman: New > WebSocket Request, paste the URL above."
          }
        }
      ]
    }
  ]
}
