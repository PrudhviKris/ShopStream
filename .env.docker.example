# Copy to .env next to docker-compose.yml, then fill in real values.
#   cp .env.docker.example .env
#
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- database (MySQL runs in the compose stack) ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=ecommerce
MYSQL_PASSWORD=change-me-app
MYSQL_DB=ecommerce

# ---- secrets (required, no defaults) ----
JWT_SECRET_KEY=
DJANGO_SECRET_KEY=

# ---- where the app is reachable ----
# Used for OAuth redirect URIs and the links in emails. Behind a domain or a
# tunnel, set the public https:// URL here.
PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8001
DJANGO_DEBUG=0
API_PORT=8000
ADMIN_PORT=8001

# ---- payments (empty = mock mode, no real charges) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=inr

# ---- social login (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ---- email ----
# database = in-app inbox only; smtp = really send (SendGrid/SES are SMTP too)
EMAIL_BACKEND=database
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@example.com

# ---- admin -> API service token ----
# Shared by both containers so the Django admin can ship/deliver/cancel an
# order through the API (same notification, email and live update as the
# storefront). Generate with secrets.token_urlsafe(32).
SERVICE_API_TOKEN=

# ---- store ----
TAX_RATE=0.08
